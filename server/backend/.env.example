HTTP_PORT=3005
WS_PORT=3006

# ── Telegram Alert Notification ──────────────────────────────────────────────
# Set true untuk mengaktifkan notifikasi Telegram
TELEGRAM_ENABLED=false
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID tujuan (dapat dari @userinfobot atau getUpdates)
TELEGRAM_CHAT_ID=
# Timeout device dianggap offline (detik) — tidak ada telemetri selama ini
ALERT_OFFLINE_TIMEOUT=60
# Cooldown minimal sebelum alert jenis sama dikirim lagi (detik)
ALERT_COOLDOWN=300